<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.App" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/bg_amarillo</item>

        <!-- En lugar de windowTranslucent* -->
        <item name="android:windowTranslucentStatus">false</item>
        <item name="android:windowTranslucentNavigation">false</item>

        <!-- Edge-to-edge moderno -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

        <!-- Mantén esto si tienes notch/cutout -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:ignore="NewApi">shortEdges</item>

        <!-- Splash del sistema Android 12+: lo hacemos invisible -->
        <item name="android:windowSplashScreenBackground" tools:ignore="NewApi">@color/bg_amarillo</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:ignore="NewApi">@drawable/splash_icon_transparent</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:ignore="NewApi">@color/bg_amarillo</item>
    </style>
</resources>